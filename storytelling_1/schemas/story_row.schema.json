{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "storytelling_1 story row",
  "type": "object",
  "required": [
    "request_id",
    "study_id",
    "provider",
    "model",
    "prompt_id",
    "prompt_text",
    "replicate",
    "status",
    "created_at_utc"
  ],
  "properties": {
    "request_id": {"type": "string"},
    "study_id": {"type": "string"},
    "provider": {"enum": ["openai", "anthropic", "gemini"]},
    "model": {"type": "string"},
    "prompt_id": {"type": "string"},
    "prompt_group": {"type": "string"},
    "prompt_text": {"type": "string"},
    "replicate": {"type": "integer", "minimum": 1},
    "status": {"enum": ["ok", "error"]},
    "response_text": {"type": ["string", "null"]},
    "created_at_utc": {"type": "string"},
    "elapsed_seconds": {"type": ["number", "null"]},
    "input_tokens": {"type": ["integer", "null"]},
    "output_tokens": {"type": ["integer", "null"]},
    "total_tokens": {"type": ["integer", "null"]},
    "finish_reason": {"type": ["string", "null"]},
    "provider_response_id": {"type": ["string", "null"]},
    "response_sha256": {"type": ["string", "null"]},
    "error_type": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]},
    "provider_meta_json": {"type": ["string", "null"]}
  }
}
